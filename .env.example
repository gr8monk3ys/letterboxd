# Letterboxd credentials
LETTERBOXD_USERNAME=""
LETTERBOXD_PASSWORD=""

# API Keys
# Review generation needs ONE of these three. Pick the vendor you have a
# key for; AI_PROVIDER (or --provider) selects it.
ANTHROPIC_API_KEY=""   # console.anthropic.com/settings/keys
OPENAI_API_KEY=""      # optional: needs `uv sync --extra openai`
GEMINI_API_KEY=""      # optional: needs `uv sync --extra gemini`
AI_PROVIDER="anthropic"  # anthropic | openai | gemini

TMDB_API_KEY=""  # Optional: Get from https://www.themoviedb.org/settings/api

# Browser settings (optional)
# HEADLESS=true  # Run browser without visible window

# Timeout settings in milliseconds (optional)
# PAGE_LOAD_TIMEOUT=30000
# ELEMENT_TIMEOUT=10000

# Rate limiting (optional)
# HOURLY_RATE_LIMIT=30
# DAILY_RATE_LIMIT=100

# Review settings (optional)
# REVIEW_TONE=casual  # Options: casual, snarky, thoughtful, brief, analytical

